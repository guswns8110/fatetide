# Public build-time values for production builds. These are not secrets.
# Cloudflare Pages environment variables override anything set here.

# AdSense publisher ID. Only adds the site-verification meta tag; it loads no ad script by itself.
PUBLIC_ADSENSE_CLIENT=ca-pub-8201951053340791
# Ads stay off until AdSense approves the site and this is set to true.
PUBLIC_ADSENSE_ENABLED=false
