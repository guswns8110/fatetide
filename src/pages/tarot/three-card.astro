---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import NoScriptNote from '../../components/common/NoScriptNote.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import type { Crumb } from '../../config/site';
import ThreeCardReading from '../../components/tarot/ThreeCardReading';
import RelatedReadings from '../../components/tarot/RelatedReadings.astro';
import { getArtworkIds } from '../../utils/artwork';
import '../../styles/tarot.css';

const artworkIds = getArtworkIds();
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Tarot', path: '/tarot/' },
  { name: 'Three Card', path: '/tarot/three-card/' },
];
---

<BaseLayout title="Three Card Tarot Reading" description="Draw three tarot cards for past, present, and future, with reflections for love, career, money, or life in general." breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />
  <NoScriptNote feature="tarot readings" />
  <section class="one-card-intro container"><p class="eyebrow">The three card spread</p><h1>Past, present, future.</h1><p class="lead">Choose a focus and draw three cards. Read them as a story: what shaped this, what is here now, and what may be worth preparing for.</p><a href="/" class="back-home">← Back to home</a></section>
  <ThreeCardReading artworkIds={artworkIds} client:load />
  <RelatedReadings current="/tarot/three-card/" />
  <AdSlot placement="tarot-three-card-below-reading" />
</BaseLayout>
