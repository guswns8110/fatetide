---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import NoScriptNote from '../../components/common/NoScriptNote.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import type { Crumb } from '../../config/site';
import OneCardReading from '../../components/tarot/OneCardReading';
import RelatedReadings from '../../components/tarot/RelatedReadings.astro';
import { getArtworkIds } from '../../utils/artwork';
import '../../styles/tarot.css';

const artworkIds = getArtworkIds();
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Tarot', path: '/tarot/' },
  { name: 'One Card', path: '/tarot/one-card/' },
];
---

<BaseLayout noindex title="One Card Tarot Reading" description="Choose a focus and draw one tarot card for a thoughtful perspective on love, career, money, or life in general." breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />
  <NoScriptNote feature="tarot readings" />
  <section class="one-card-intro container"><p class="eyebrow">The one card ritual</p><h1>One card. A new perspective.</h1><p class="lead">Take a quiet moment to consider what is on your mind. Choose a focus, shuffle the deck, and see what your card invites you to notice.</p><a href="/" class="back-home">← Back to home</a></section>
  <OneCardReading artworkIds={artworkIds} client:load />
  <RelatedReadings current="/tarot/one-card/" />
  <AdSlot placement="tarot-one-card-below-reading" />
</BaseLayout>
