---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import NoScriptNote from '../../components/common/NoScriptNote.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import type { Crumb } from '../../config/site';
import DailyReading from '../../components/tarot/DailyReading';
import RelatedReadings from '../../components/tarot/RelatedReadings.astro';
import { getArtworkIds } from '../../utils/artwork';
import '../../styles/tarot.css';

const artworkIds = getArtworkIds();
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Tarot', path: '/tarot/' },
  { name: 'Daily', path: '/tarot/daily/' },
];
---

<BaseLayout title="Daily Tarot Card" description="Draw your daily tarot card for a theme and a gentle question to carry through the day. Your card is kept on your device until tomorrow." breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />
  <NoScriptNote feature="tarot readings" />
  <section class="one-card-intro container"><p class="eyebrow">A ritual for every day</p><h1>Your card for today.</h1><p class="lead">Draw one card each day for a theme to notice and a question to carry. Your card is saved only on this device, and a new one is waiting tomorrow.</p><a href="/" class="back-home">← Back to home</a></section>
  <DailyReading artworkIds={artworkIds} client:load />
  <RelatedReadings current="/tarot/daily/" />
  <AdSlot placement="tarot-daily-below-reading" />
</BaseLayout>
