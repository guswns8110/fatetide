---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page could not be found. Return to the FateTide homepage." noindex>
  <section class="not-found container">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This path has faded from view.</h1>
    <p class="lead">The page you were looking for does not exist.</p>
    <a class="button button-primary" href="/">Return home</a>
  </section>
</BaseLayout>
