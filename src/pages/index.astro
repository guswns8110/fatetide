---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECT_NAME } from '../config/site';

const steps = [
  { number: '01', title: 'Choose', text: 'Pick Yes or No for a question on your mind, or Today for the day ahead.' },
  { number: '02', title: 'Draw', text: 'Shuffle and choose the card that calls to you, or reveal the card for today.' },
  { number: '03', title: 'Reflect', text: 'Read what the card suggests, and take whatever is useful from it.' },
];
---

<BaseLayout isHome title="Yes or No Tarot and Today's Fortune" description="Ask the cards a yes or no question, or see today's tarot card and horoscope. A simple, calm place for reflection.">
  <section class="home-hero container">
    <p class="eyebrow">{PROJECT_NAME}</p>
    <h1>A little guidance for today.</h1>
    <p class="lead">Ask the cards a question, or see the card and the stars for your day. Simple, quiet, and made for reflection.</p>
  </section>

  <section class="choice-grid container" aria-label="Choose a reading">
    <a class="choice-card" href="/yes-or-no/">
      <div><span class="choice-symbol" aria-hidden="true">◐</span><h2>Yes or No</h2><p>Ask a question.<br />Draw one card.</p></div>
      <span class="button button-primary choice-cta">Ask the cards <span aria-hidden="true">↗</span></span>
    </a>
    <a class="choice-card" href="/today/">
      <div><span class="choice-symbol" aria-hidden="true">☀</span><h2>Today's Fortune</h2><p>A card and a little guidance<br />for the day ahead.</p></div>
      <span class="button button-primary choice-cta">See today <span aria-hidden="true">↗</span></span>
    </a>
  </section>

  <section class="home-steps container" aria-labelledby="how-title">
    <h2 id="how-title">How {PROJECT_NAME} works</h2>
    <ol class="steps">
      {steps.map((step) => <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
    </ol>
  </section>

  <section class="home-zodiac container">
    <p>Curious about your sign?</p>
    <a href="/horoscope/">Explore the Zodiac →</a>
  </section>
</BaseLayout>
