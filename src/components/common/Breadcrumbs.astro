---
import type { Crumb } from '../../config/site';

interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => <li>{index < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>)}
  </ol>
</nav>
