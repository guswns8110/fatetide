---
import { PROJECT_NAME, primaryNavigation } from '../../config/site';

const path = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${PROJECT_NAME} home`}><span aria-hidden="true">✦</span> {PROJECT_NAME}</a>
    <nav class="site-nav" aria-label="Main navigation">
      <ul>
        {primaryNavigation.map((item) => <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
