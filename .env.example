# Real origin of the deployed site, for example https://example.com (no path). Leave empty until known.
PUBLIC_SITE_URL=
# Optional public contact address shown in the footer and policy pages. Leave empty to hide it.
PUBLIC_CONTACT_EMAIL=
# AdSense publisher ID (ca-pub-...). Leave empty until you have one.
PUBLIC_ADSENSE_CLIENT=
# Ads stay off unless this is exactly "true" AND the client ID above is valid.
PUBLIC_ADSENSE_ENABLED=false
